{
  "manifest_version": 3,
  "name": "Downloader Pro Free (DPF) Integration",
  "version": "1.0.2",
  "description": "High-Speed Dynamic Download Acceleration and Floating Video Grabber for Downloader Pro Free",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": "icons/icon48.png",
    "default_popup": "popup/popup.html",
    "default_title": "Downloader Pro Free"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "downloads",
    "nativeMessaging",
    "storage",
    "contextMenus",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
